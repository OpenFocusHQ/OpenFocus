    {
      "id": "procrastislime",
      "name": "Procrastislime",
      "description": "A sticky blob that turns 'now' into 'later'.",
      "hp": 200,
      "strength": 4,
      "color": "#3E8E5E",
      "shape": "slime",
      "sprite": "px_enemy_procrastislime",
      "dialogue": {
        "appear": [
          "Why today? Tomorrow is so comfy…"
        ],
        "hit": [
          "Later, later, later!"
        ],
        "defeat": [
          "Fine… do it now… *blorp*"
        ]
      }
    },
    {
      "id": "doubt_golem",
      "name": "The Doubt Golem",
      "description": "Built from every 'I can't'. Slow, heavy, and beatable.",
      "hp": 400,
      "strength": 6,
      "color": "#8E91A6",
      "shape": "golem",
      "sprite": "px_enemy_doubt_golem",
      "dialogue": {
        "appear": [
          "You? Climb that? Ha."
        ],
        "hit": [
          "See? You're not the type."
        ],
        "defeat": [
          "Perhaps… you are… the type…"
        ]
      }
    }
  ],
  "titles": [
