{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/graphicmismatch/OpenFocus/tools/content-editor/content.schema.json",
  "title": "OpenFocus game content",
  "description": "All cosmetics, achievements, starter quests, titles and messages. Edit with tools/content-editor.",
  "type": "object",
  "required": [
    "version",
    "slots",
    "items",
    "achievements",
    "quests",
    "titles",
    "messages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "layer"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "integer",
            "description": "Draw order; the hero body is layer 1."
          },
          "kind": {
            "enum": [
              "BACKDROP",
              "BODY",
              "OVERLAY"
            ],
            "default": "OVERLAY"
          },
          "anchor": {
            "enum": [
              "head",
              "body",
              null
            ],
            "description": "Body anchor an OVERLAY follows."
          },
          "required": {
            "type": "boolean"
          },
          "defaultItem": {
            "type": [
              "string",
              "null"
            ]
          },
          "defaultSprite": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slot",
          "price"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "minimum": 0
          },
          "minLevel": {
            "type": "integer",
            "minimum": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "sprite": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^px_[a-z0-9_]+$"
          },
          "frames": {
            "type": "integer",
            "minimum": 1
          },
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "stat",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "xp": {
            "type": "integer",
            "minimum": 0
          },
          "coins": {
            "type": "integer",
            "minimum": 0
          },
          "stat": {
            "enum": [
              "level",
              "habitCompletions",
              "bestHabitStreak",
              "focusMinutes",
              "focusSessions",
              "goalsCompleted",
              "milestonesDone",
              "temptationsResisted",
              "shortsBlocked",
              "rewardsRedeemed",
              "itemsOwned"
            ]
          },
          "target": {
            "type": "integer",
            "minimum": 1
          },
          "tier": {
            "enum": [
              "bronze",
              "silver",
              "gold"
            ]
          }
        }
      }
    },
    "quests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "enum": [
              "Star",
              "Run",
              "Book",
              "Water",
              "Meditate",
              "Fitness",
              "Sleep",
              "Food",
              "Code",
              "Music",
              "Brush",
              "Language",
              "School",
              "Clean",
              "Money",
              "Heart",
              "Phone",
              "NoPhone",
              "Smoke",
              "Sun",
              "Walk",
              "Journal",
              "Plant",
              "Call"
            ]
          },
          "color": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "kind": {
            "enum": [
              "BUILD",
              "BREAK"
            ]
          },
          "difficulty": {
            "enum": [
              "TRIVIAL",
              "EASY",
              "MEDIUM",
              "HARD"
            ]
          },
          "frequency": {
            "enum": [
              "DAILY",
              "WEEKLY",
              "SPECIFIC_DAYS"
            ]
          },
          "target": {
            "type": "integer",
            "minimum": 1
          },
          "starter": {
            "type": "boolean"
          }
        }
      }
    },
    "titles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "minLevel",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "minLevel": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "general",
        "resist",
        "blocked",
        "shorts",
        "comeback"
      ],
      "properties": {
        "general": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resist": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shorts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "comeback": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
